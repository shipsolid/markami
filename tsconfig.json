{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "skipLibCheck": true
  },
  "include": ["src/core/**/*.ts", "src/extension/**/*.ts", "src/protocol/**/*.ts"]
}
