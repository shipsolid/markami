{
  "name": "markami",
  "displayName": "markami",
  "description": "Source-preserving rendered Markdown editing for VS Code.",
  "version": "0.1.0",
  "publisher": "markami-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.102.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:markami.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markami.editor",
        "displayName": "markami",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markami.openRendered",
        "title": "markami: Open Rendered Editor"
      },
      {
        "command": "markami.openSource",
        "title": "markami: Open Source Editor"
      },
      {
        "command": "markami.bold",
        "title": "markami: Bold"
      },
      {
        "command": "markami.italic",
        "title": "markami: Italic"
      },
      {
        "command": "markami.strikethrough",
        "title": "markami: Strikethrough"
      },
      {
        "command": "markami.inlineCode",
        "title": "markami: Inline Code"
      },
      {
        "command": "markami.link",
        "title": "markami: Create or Edit Link"
      },
      {
        "command": "markami.clearFormatting",
        "title": "markami: Clear Formatting"
      },
      {
        "command": "markami.paragraph",
        "title": "markami: Paragraph"
      },
      {
        "command": "markami.heading1",
        "title": "markami: Heading 1"
      },
      {
        "command": "markami.heading2",
        "title": "markami: Heading 2"
      },
      {
        "command": "markami.heading3",
        "title": "markami: Heading 3"
      },
      {
        "command": "markami.heading4",
        "title": "markami: Heading 4"
      },
      {
        "command": "markami.heading5",
        "title": "markami: Heading 5"
      },
      {
        "command": "markami.heading6",
        "title": "markami: Heading 6"
      },
      {
        "command": "markami.showSelectionToolbar",
        "title": "markami: Show Selection Toolbar"
      },
      {
        "command": "markami.openSlashCommands",
        "title": "markami: Open Slash Commands"
      },
      {
        "command": "markami.moveBlockUp",
        "title": "markami: Move Block Up"
      },
      {
        "command": "markami.moveBlockDown",
        "title": "markami: Move Block Down"
      },
      {
        "command": "markami.moveBlockTo",
        "title": "markami: Move Block To…"
      },
      {
        "command": "markami.setDocumentAppearance",
        "title": "markami: Set Document Appearance"
      },
      {
        "command": "markami.setDocumentWidth",
        "title": "markami: Set Document Width"
      },
      {
        "command": "markami.resetFileViewPreferences",
        "title": "markami: Reset View Preferences for This File"
      },
      {
        "command": "markami.resetWorkspaceViewPreferences",
        "title": "markami: Reset View Preferences for This Workspace"
      }
    ],
    "keybindings": [
      {
        "command": "markami.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.link",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == markami.editor"
      }
    ],
    "configuration": {
      "title": "markami",
      "properties": {
        "markami.selectionToolbar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show the floating formatting toolbar for eligible selections. Shortcuts and the explicit toolbar command remain available when disabled."
        },
        "markami.slashCommands.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Open the block insertion palette when slash is typed in an empty top-level paragraph. The explicit command remains available when disabled."
        },
        "markami.renderMath": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable local math rendering and math block insertion."
        },
        "markami.renderMermaid": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render Mermaid diagrams locally while preserving their fenced source."
        },
        "markami.codeBlock.wrap": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Wrap long lines inside fenced code blocks."
        },
        "markami.blockHandles.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show top-level block handles. Keyboard block-move commands remain available when disabled."
        },
        "markami.appearance.mode": {
          "type": "string",
          "enum": ["vscode", "document"],
          "enumDescriptions": ["Compact, editor-oriented typography.", "Comfortable document-oriented typography."],
          "default": "vscode",
          "scope": "resource",
          "description": "Set the default presentation for rendered Markdown. This never changes document source."
        },
        "markami.document.width": {
          "type": "string",
          "enum": ["auto", "readable", "full"],
          "enumDescriptions": ["Center content up to the configured maximum.", "Cap prose at 80 characters and the configured maximum.", "Use all available content width."],
          "default": "auto",
          "scope": "resource",
          "description": "Set the default rendered document width. This never changes document source."
        },
        "markami.document.maxContentWidth": {
          "type": "integer",
          "minimum": 480,
          "maximum": 2400,
          "default": 960,
          "scope": "resource",
          "description": "Set the maximum content width in CSS pixels for Auto and Readable width modes."
        },
        "markami.viewPreferences.rememberPerFile": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Remember presentation overrides per saved document. Turning this off keeps changes for the current session only; reset commands remove stored overrides."
        },
        "markami.syntaxReveal": {
          "type": "string",
          "enum": ["activeBlock", "selection", "manual"],
          "enumDescriptions": ["Reveal syntax for the active block.", "Reveal syntax only where the selection intersects it.", "Keep supported constructs rendered until source reveal is requested."],
          "default": "activeBlock",
          "scope": "resource",
          "description": "Set the default Markdown syntax reveal policy. A per-file override may replace this presentation setting."
        },
        "markami.theme.useEditorFont": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Use the configured VS Code editor font in VS Code appearance mode. Document mode always uses the UI font."
        },
        "markami.remoteImages": {
          "type": "string",
          "enum": ["block", "prompt", "allow"],
          "default": "block",
          "scope": "resource",
          "description": "Control whether remote HTTPS images are blocked, confirmed before loading, or allowed. Document source is always preserved."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "build:integration": "tsc -p tsconfig.integration.json",
    "build": "npm run clean && npm run build:extension && npm run build:webview",
    "test:unit": "vitest run test/unit",
    "test:fidelity": "vitest run test/fidelity",
    "test:protocol": "vitest run test/protocol",
    "test:webview": "vitest run test/webview",
    "test:integration": "npm run build && npm run build:integration && node scripts/runIntegration.mjs",
    "test:visual": "vitest run test/visual",
    "test:visual:browser": "playwright test --config playwright.visual.config.ts",
    "bench": "node scripts/bench.mjs",
    "package": "npm run build && vsce package --out artifacts/markami-0.1.0.vsix",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:protocol && npm run test:fidelity && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/yaml": "1.0.4",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "glob": "13.0.6",
    "jsdom": "30.1.2",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
