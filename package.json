{
  "name": "markami",
  "displayName": "markami — Rendered Markdown Editor",
  "description": "Edit Markdown directly in a rendered, source-preserving VS Code editor.",
  "version": "0.1.3",
  "publisher": "shipsolid",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#071D49",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shipsolid/markami.git"
  },
  "homepage": "https://github.com/shipsolid/markami#readme",
  "bugs": {
    "url": "https://github.com/shipsolid/markami/issues"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "editor",
    "wysiwym",
    "gfm",
    "source-preserving",
    "mermaid",
    "technical-writing"
  ],
  "engines": {
    "vscode": "^1.102.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:markami.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markami.editor",
        "displayName": "markami",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markami.openRendered",
        "title": "markami: Open Rendered Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "markami.openSource",
        "title": "markami: Open Source Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markami.openSample",
        "title": "markami: Open Sample Document"
      },
      {
        "command": "markami.setAsDefault",
        "title": "markami: Make markami the Default Markdown Editor"
      },
      {
        "command": "markami.restoreNativeDefault",
        "title": "markami: Use Native Markdown Editor by Default"
      },
      {
        "command": "markami.toggleSourceReveal",
        "title": "markami: Toggle Source Reveal for Current Block"
      },
      {
        "command": "markami.revealCurrentBlock",
        "title": "markami: Reveal Current Block as Markdown"
      },
      {
        "command": "markami.bold",
        "title": "markami: Toggle Bold"
      },
      {
        "command": "markami.italic",
        "title": "markami: Toggle Italic"
      },
      {
        "command": "markami.strikethrough",
        "title": "markami: Toggle Strikethrough"
      },
      {
        "command": "markami.inlineCode",
        "title": "markami: Toggle Inline Code"
      },
      {
        "command": "markami.link",
        "title": "markami: Create or Edit Link"
      },
      {
        "command": "markami.clearFormatting",
        "title": "markami: Clear Inline Formatting"
      },
      {
        "command": "markami.paragraph",
        "title": "markami: Paragraph"
      },
      {
        "command": "markami.heading1",
        "title": "markami: Heading 1"
      },
      {
        "command": "markami.heading2",
        "title": "markami: Heading 2"
      },
      {
        "command": "markami.heading3",
        "title": "markami: Heading 3"
      },
      {
        "command": "markami.heading4",
        "title": "markami: Heading 4"
      },
      {
        "command": "markami.heading5",
        "title": "markami: Heading 5"
      },
      {
        "command": "markami.heading6",
        "title": "markami: Heading 6"
      },
      {
        "command": "markami.showSelectionToolbar",
        "title": "markami: Show Selection Toolbar"
      },
      {
        "command": "markami.openSlashCommands",
        "title": "markami: Open Slash Commands"
      },
      {
        "command": "markami.moveBlockUp",
        "title": "markami: Move Block Up"
      },
      {
        "command": "markami.moveBlockDown",
        "title": "markami: Move Block Down"
      },
      {
        "command": "markami.moveBlockTo",
        "title": "markami: Move Block To…"
      },
      {
        "command": "markami.toggleDocumentAppearance",
        "title": "markami: Toggle Document Appearance",
        "icon": "$(color-mode)"
      },
      {
        "command": "markami.setDocumentAppearance",
        "title": "markami: Set Document Appearance"
      },
      {
        "command": "markami.setDocumentWidth",
        "title": "markami: Set Document Width"
      },
      {
        "command": "markami.resetFileViewPreferences",
        "title": "markami: Reset File View Preferences"
      },
      {
        "command": "markami.resetWorkspaceViewPreferences",
        "title": "markami: Reset Workspace View Preferences"
      },
      {
        "command": "markami.insertHeading",
        "title": "markami: Insert Heading"
      },
      {
        "command": "markami.insertBulletList",
        "title": "markami: Insert Bullet List"
      },
      {
        "command": "markami.insertNumberedList",
        "title": "markami: Insert Numbered List"
      },
      {
        "command": "markami.insertTaskList",
        "title": "markami: Insert Task List"
      },
      {
        "command": "markami.insertCodeBlock",
        "title": "markami: Insert Code Block"
      },
      {
        "command": "markami.insertMermaidBlock",
        "title": "markami: Insert Mermaid Block"
      },
      {
        "command": "markami.insertTable",
        "title": "markami: Insert Table"
      },
      {
        "command": "markami.refreshRenderedBlocks",
        "title": "markami: Refresh Rendered Blocks"
      },
      {
        "command": "markami.copyCurrentBlockMarkdown",
        "title": "markami: Copy Current Block as Markdown"
      },
      {
        "command": "markami.insertImage",
        "title": "markami: Insert Image"
      },
      {
        "command": "markami.insertMathBlock",
        "title": "markami: Insert Math Block"
      },
      {
        "command": "markami.insertDivider",
        "title": "markami: Insert Divider"
      },
      {
        "command": "markami.showDiagnostics",
        "title": "markami: Show Diagnostics"
      },
      {
        "command": "markami.find",
        "title": "markami: Find in Document Text"
      },
      {
        "command": "markami.findSource",
        "title": "markami: Find in Markdown Source"
      }
    ],
    "walkthroughs": [
      {
        "id": "markami.gettingStarted",
        "title": "Get started with markami",
        "description": "Edit Markdown in the rendered document and keep your source intact.",
        "steps": [
          {
            "id": "markami.open",
            "title": "Open a Markdown file in markami",
            "description": "Click the markami icon in the editor title bar of any Markdown file, or start with a sample.\n[Open the sample document](command:markami.openSample)",
            "media": { "markdown": "media/walkthrough/open.md" },
            "completionEvents": ["onCommand:markami.openRendered", "onCommand:markami.openSample"]
          },
          {
            "id": "markami.edit",
            "title": "Edit, save, and check the diff",
            "description": "Change something in the rendered document and save. In a Git repository, only the lines you changed show up.\n[Show Source Control](command:workbench.view.scm)",
            "media": { "markdown": "media/walkthrough/edit.md" },
            "completionEvents": ["onStepSelected"]
          },
          {
            "id": "markami.default",
            "title": "Choose your default editor",
            "description": "markami is opt-in. Use it for every Markdown file, or switch back at any time.\n[Use markami for Markdown files](command:markami.setAsDefault)\n[Use the native editor by default](command:markami.restoreNativeDefault)",
            "media": { "markdown": "media/walkthrough/default.md" },
            "completionEvents": ["onCommand:markami.setAsDefault", "onCommand:markami.restoreNativeDefault"]
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markami.toggleDocumentAppearance",
          "when": "activeCustomEditorId == markami.editor",
          "group": "navigation@1"
        },
        {
          "command": "markami.openSource",
          "when": "activeCustomEditorId == markami.editor",
          "group": "navigation@2"
        },
        {
          "command": "markami.openRendered",
          "when": "resourceLangId == markdown && activeCustomEditorId != markami.editor",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markami.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.link",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.toggleSourceReveal",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId == markami.editor"
      },
      {
        "command": "markami.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == markami.editor"
      }
    ],
    "configuration": {
      "title": "markami",
      "properties": {
        "markami.selectionToolbar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show the floating formatting toolbar for eligible selections. Shortcuts and the explicit toolbar command remain available when disabled."
        },
        "markami.slashCommands.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Open the block insertion palette when slash is typed in an empty top-level paragraph. The explicit command remains available when disabled."
        },
        "markami.renderMath": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable local math rendering and math block insertion."
        },
        "markami.renderMermaid": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render Mermaid diagrams locally while preserving their fenced source."
        },
        "markami.renderSafeHtml": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render allowlisted local HTML. Unsafe or uncertain HTML always remains editable source."
        },
        "markami.codeBlock.wrap": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Wrap long lines inside fenced code blocks."
        },
        "markami.codeBlock.lineNumbers": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show line numbers in fenced code blocks that have more than one line."
        },
        "markami.blockHandles.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show top-level block handles. Keyboard block-move commands remain available when disabled."
        },
        "markami.outline.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show the document heading outline. Collapse state may be remembered per file."
        },
        "markami.appearance.mode": {
          "type": "string",
          "enum": ["vscode", "document"],
          "enumDescriptions": ["Clean VS Code Markdown-preview typography in your exact theme colors.", "Designed reading view with bundled fonts and an optional Catppuccin Mocha palette."],
          "default": "vscode",
          "scope": "resource",
          "description": "Set the default presentation for rendered Markdown. This never changes document source."
        },
        "markami.document.width": {
          "type": "string",
          "enum": ["auto", "readable", "full"],
          "enumDescriptions": ["Center content up to the configured maximum.", "Cap prose at 80 characters and the configured maximum.", "Use all available content width."],
          "default": "auto",
          "scope": "resource",
          "description": "Set the default rendered document width. This never changes document source."
        },
        "markami.document.palette": {
          "type": "string",
          "enum": ["catppuccin-mocha", "vscode"],
          "enumDescriptions": ["Use the Catppuccin Mocha palette in Document appearance when VS Code uses a dark theme.", "Always use the colors of the active VS Code theme."],
          "default": "catppuccin-mocha",
          "scope": "resource",
          "description": "Choose the colors of Document appearance. Light and high-contrast themes, and VS Code appearance, always follow the active VS Code theme."
        },
        "markami.document.maxContentWidth": {
          "type": "integer",
          "minimum": 480,
          "maximum": 2400,
          "default": 1200,
          "scope": "resource",
          "description": "Set the maximum content width in CSS pixels for Auto and Readable width modes."
        },
        "markami.viewPreferences.rememberPerFile": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Remember presentation overrides per saved document. Turning this off keeps changes for the current session only; reset commands remove stored overrides."
        },
        "markami.syntaxReveal": {
          "type": "string",
          "enum": ["activeBlock", "selection", "manual"],
          "enumDescriptions": ["Reveal syntax for the active block.", "Reveal syntax only where the selection intersects it.", "Keep supported constructs rendered until source reveal is requested."],
          "default": "activeBlock",
          "scope": "resource",
          "description": "Set the default Markdown syntax reveal policy. A per-file override may replace this presentation setting."
        },
        "markami.theme.useEditorFont": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Use the configured VS Code editor font for prose in VS Code appearance. Off by default so prose uses the UI font; code always uses the editor font. Document appearance uses its own fonts."
        },
        "markami.sourceIslands.showLabel": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show a source-only label for Markdown regions that cannot be rendered safely."
        },
        "markami.assets.pasteDirectory": {
          "type": "string",
          "default": "assets/${documentBasename}",
          "scope": "resource",
          "description": "Workspace-relative destination template reserved for explicitly accepted image copies."
        },
        "markami.debug.showSourceRanges": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show source-range diagnostics for markami development and troubleshooting."
        },
        "markami.remoteImages": {
          "type": "string",
          "enum": ["block", "prompt", "allow"],
          "default": "prompt",
          "scope": "resource",
          "description": "Control whether remote HTTPS images are blocked, confirmed before loading, or allowed. Document source is always preserved."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.bench.json --noEmit && tsc -p tsconfig.marketplace-capture.json --noEmit",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "build:integration": "tsc -p tsconfig.integration.json",
    "build:marketplace-capture": "tsc -p tsconfig.marketplace-capture.json",
    "build": "npm run clean && npm run build:extension && npm run build:webview",
    "test:unit": "vitest run test/unit",
    "test:fidelity": "vitest run test/fidelity",
    "test:protocol": "vitest run test/protocol",
    "test:webview": "vitest run test/webview",
    "test:integration": "npm run build && npm run build:integration && node scripts/runIntegration.mjs",
    "test:visual": "vitest run test/visual",
    "test:visual:browser": "playwright test --config playwright.visual.config.ts",
    "bench": "node scripts/bench.mjs",
    "test:package": "node --test scripts/checkPackage.test.mjs scripts/licensePolicy.test.mjs scripts/packagingEnvironment.test.mjs",
    "test:release": "node scripts/releasePreflight.test.mjs",
    "test:marketplace": "node --test scripts/marketplaceListing.test.mjs scripts/runMarketplaceCapture.test.mjs scripts/captureWorkspace.test.mjs scripts/gitRevision.test.mjs",
    "test:install-smoke": "node --test scripts/installSmoke.test.mjs",
    "check:licenses": "node scripts/checkLicenses.mjs",
    "generate:notices": "node scripts/generateNotices.mjs",
    "package": "node scripts/package.mjs",
    "check:package": "node scripts/checkPackage.mjs",
    "release:preflight": "node scripts/releasePreflight.mjs",
    "capture:marketplace": "node scripts/runMarketplaceCapture.mjs",
    "smoke:install": "npm run build:integration && node scripts/installSmoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:protocol && npm run test:fidelity && npm run test:package && npm run test:release && npm run test:marketplace && npm run test:install-smoke && npm run check:licenses && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/shantell-sans": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/yaml": "1.0.4",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "glob": "13.0.6",
    "jsdom": "30.1.2",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yauzl": "3.4.0"
  }
}
